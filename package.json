{
  "name": "alphaflowx-app",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone AlphaFlowX mobile app built with Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "android:release": "bash scripts/build-android-release.sh"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/share": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/ios": "^7.0.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.1"
  }
}
